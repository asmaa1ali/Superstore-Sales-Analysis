      <column caption='%Chg (Profit)' datatype='real' default-format='*+0.00%;-0.0%' name='[%Chg (copy)_1577317345656833]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([sales CY (copy)_1577317345656832]- [sales PY  (copy)_1577317345656834]))&#13;&#10;/SUM([sales PY  (copy)_1577317345656834])' />

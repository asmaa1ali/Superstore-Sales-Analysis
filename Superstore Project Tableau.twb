              <calculation class='tableau' formula='{FIXED [order_id] : SUM([profit])}' />
            </column>
            <column caption='% PROFITABLE ORDERS' datatype='real' default-format='p0.00%' name='[Calculation_1630026805133320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{COUNTD(IF [Calculation_1630026794958854]&gt;0 THEN [order_id]END)/COUNTD([order_id])}' />

      <column caption='%Chg' datatype='real' default-format='*+0.00%;-0.0%' name='[Calculation_1553402890383362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1553402887835648]- [sales CY (copy)_1553402888933377]))&#13;&#10;/SUM([sales CY (copy)_1553402888933377])' />
      </column>
      <column caption='Last 12 month' datatype='boolean' name='[Calculation_1553402894110723]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [order_date])&#13;&#10;&gt;=&#13;&#10;DATEADD(&apos;month&apos;,-11,{MAX(DATETRUNC(&apos;month&apos;, [order_date]))})' />
      </column>
      <column caption='+ve %Diff' datatype='string' name='[Calculation_1577317370888196]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation1] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='-ve %Diff' datatype='string' name='[Calculation_1577317371289605]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation1] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;END'>

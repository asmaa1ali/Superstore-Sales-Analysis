    <worksheet name='Compleated or returned by month'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Yu Gothic UI' fontsize='10'>    Monthly | &lt;</run>
            <run fontname='Yu Gothic UI' fontsize='10'>[Parameters].[Parameter 4]</run>
            <run fontname='Yu Gothic UI' fontsize='10'>&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders+ (Multiple Connections)' name='federated.04l5vr91kk6rwa12djl0f11gf21b' />
            <datasource name='Parameters' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Completed' caption='Order Status' datatype='real' name='[Parameter 4]' param-domain-type='list' role='measure' type='quantitative' value='1.'>
              <calculation class='tableau' formula='1.' />
              <aliases>
                <alias key='1.' value='Completed' />
                <alias key='2.' value='Returned' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04l5vr91kk6rwa12djl0f11gf21b'>
            <column caption='%Chg (Profit)' datatype='real' default-format='*+0.00%;-0.0%' name='[%Chg (copy)_1577317345656833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([sales CY (copy)_1577317345656832]- [sales PY  (copy)_1577317345656834]))&#13;&#10;/SUM([sales PY  (copy)_1577317345656834])' />
            </column>
            <column caption='Bubble -Y' datatype='real' name='[Bubble -X (copy)_2065499788058627]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[segment]= &quot;Consumer&quot; THEN 1&#13;&#10;ELSEIF [segment]=&quot;Corporate&quot; THEN 0.75&#13;&#10;ELSEIF [segment]=&quot;Home Office&quot; THEN -2&#13;&#10;END' />
            </column>
            <column caption='%Difference' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([profit])) - LOOKUP(ZN(SUM([profit])), -1)) / ABS(LOOKUP(ZN(SUM([profit])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Sum' caption='Total Orders Placed By Customer' datatype='integer' name='[Calculation_0077791953297415]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='// Returns all the orders placed by a customer&#13;&#10;{ FIXED [customer_name]:[Calculation_1213312394600478]}' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_0077792032862219]' role='measure' type='quantitative' user:unnamed='Compleated or returned by month'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Returned Quantity' datatype='integer' name='[Calculation_1213312264929285]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Returned] = &quot;Yes&quot; THEN [quantity] ELSE 0 END' />
            </column>
            <column caption='Returned Sales Value' datatype='real' default-format='c&quot;$&quot;#,##0,,.00M;(&quot;$&quot;#,##0,,.00M)' name='[Calculation_1213312270016518]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Returned] = &quot;Yes&quot; THEN [sales] ELSE 0 END' />
            </column>
            <column caption='Returned Orders' datatype='integer' name='[Calculation_1213312277573639]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Returned] = &quot;Yes&quot; THEN [Order ID] END)' />
            </column>
            <column caption='Return Count per Order' datatype='integer' name='[Calculation_1213312298536983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Order ID] : SUM(IF [Returned] = &quot;Yes&quot; THEN 1 ELSE 0 END)}' />
            </column>
            <column caption='p. All or Returned' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1213312394600478]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#13;&#10;when 1 then COUNTD([order_id])&#13;&#10;when 2 then [Calculation_1213312277573639]&#13;&#10;END' />
            </column>
            <column caption='sales CY ( KPI)' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;(&quot;$&quot;#,##0,.00K)' name='[Calculation_1553402887835648]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([order_date])= {MAX(YEAR([order_date]))}&#13;&#10;THEN [sales]&#13;&#10;END  ) }' />
            </column>
            <column caption='%Chg' datatype='real' default-format='*+0.00%;-0.0%' name='[Calculation_1553402890383362]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Calculation_1553402887835648]- [sales CY (copy)_1553402888933377]))&#13;&#10;/SUM([sales CY (copy)_1553402888933377])' />
            </column>
            <column caption='profit for order' datatype='real' name='[Calculation_1630026794958854]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [order_id] : SUM([profit])}' />
            </column>
            <column caption='% PROFITABLE ORDERS' datatype='real' default-format='p0.00%' name='[Calculation_1630026805133320]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{COUNTD(IF [Calculation_1630026794958854]&gt;0 THEN [order_id]END)/COUNTD([order_id])}' />
            </column>
            <column caption='%LOSS ORDERS' datatype='real' default-format='p0.00%' name='[Calculation_1630026807394313]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{COUNTD(IF [Calculation_1630026794958854]&lt;=0 THEN [order_id]END)/COUNTD([order_id])}' />
            </column>
            <column caption='Bubble -X' datatype='real' name='[Calculation_2065499787030530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[segment]= &quot;Consumer&quot; THEN -1.5&#13;&#10;ELSEIF [segment]=&quot;Corporate&quot; THEN 2&#13;&#10;ELSEIF [segment]=&quot;Home Office&quot; THEN -0.75&#13;&#10;END' />
            </column>
            <column datatype='integer' name='[F1]' role='measure' type='quantitative' />
            <column datatype='string' name='[Order ID]' role='dimension' type='nominal' />
            <column datatype='string' name='[Returned]' role='dimension' type='nominal'>
              <aliases>
                <alias key='%null%' value='Completed' />
                <alias key='&quot;Yes&quot;' value='Returned' />
              </aliases>
            </column>
            <column caption='Orders' datatype='table' name='[__tableau_internal_object_id__].[Orders_4CB7B2A6F70B490289E064091C0275FA]' role='measure' type='quantitative' />
            <column caption='People' datatype='table' name='[__tableau_internal_object_id__].[People_C13475BE665C4922B390ADA329587229]' role='measure' type='quantitative' />
            <column-instance column='[__tableau_internal_object_id__].[Orders_4CB7B2A6F70B490289E064091C0275FA]' derivation='Count' name='[__tableau_internal_object_id__].[cnt:Orders_4CB7B2A6F70B490289E064091C0275FA:qk]' pivot='key' type='quantitative' />
            <column-instance column='[__tableau_internal_object_id__].[People_C13475BE665C4922B390ADA329587229]' derivation='Count' name='[__tableau_internal_object_id__].[cnt:People_C13475BE665C4922B390ADA329587229:qk]' pivot='key' type='quantitative' />
            <column caption='Category' datatype='string' name='[category]' role='dimension' type='nominal' />
            <column caption='Customer Name' datatype='string' name='[customer_name]' role='dimension' type='nominal' />
            <column caption='Discount' datatype='real' default-format='p0.0%' name='[discount]' role='measure' type='quantitative' visual-totals='Avg' />

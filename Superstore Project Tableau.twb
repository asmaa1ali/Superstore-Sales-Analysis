            <column caption='Bubble -X' datatype='real' name='[Calculation_2065499787030530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF[segment]= &quot;Consumer&quot; THEN -1.5&#13;&#10;ELSEIF [segment]=&quot;Corporate&quot; THEN 2&#13;&#10;ELSEIF [segment]=&quot;Home Office&quot; THEN -0.75&#13;&#10;END' />

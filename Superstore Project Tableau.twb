            </column>
            <column caption='-ve %Diff' datatype='string' name='[Calculation_1577317371289605]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation1] &lt; 0&#13;&#10;THEN &quot;▼&quot;&#13;&#10;END'>

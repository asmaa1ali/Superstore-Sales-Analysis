          <formatted-text>
            <run fontname='Yu Gothic UI' fontsize='12'>     Profit % Diff. | By</run>
            <run bold='true' fontname='Yu Gothic UI' fontsize='12'> Category</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>

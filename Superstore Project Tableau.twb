              <calculation class='tableau' formula='COUNTD(IF [Returned] = &quot;Yes&quot; THEN [Order ID] END)' />
            </column>
            <column caption='Return Count per Order' datatype='integer' name='[Calculation_1213312298536983]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [Order ID] : SUM(IF [Returned] = &quot;Yes&quot; THEN 1 ELSE 0 END)}' />
            </column>
            <column caption='sales CY ( KPI)' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;(&quot;$&quot;#,##0,.00K)' name='[Calculation_1553402887835648]' role='measure' type='quantitative'>

            <column caption='%Difference' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(ZN(SUM([profit])) - LOOKUP(ZN(SUM([profit])), -1)) / ABS(LOOKUP(ZN(SUM([profit])), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='+ve %Diff' datatype='string' name='[Calculation_1577317370888196]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation1] &gt; 0&#13;&#10;THEN &quot;▲&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />

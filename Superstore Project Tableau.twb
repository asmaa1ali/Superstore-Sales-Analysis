      </column>
      <column caption='Bubble -Y' datatype='real' name='[Bubble -X (copy)_2065499788058627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF[segment]= &quot;Consumer&quot; THEN 1&#13;&#10;ELSEIF [segment]=&quot;Corporate&quot; THEN 0.75&#13;&#10;ELSEIF [segment]=&quot;Home Office&quot; THEN -2&#13;&#10;END' />
      </column>
      <column caption='%Difference' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([profit])) - LOOKUP(ZN(SUM([profit])), -1)) / ABS(LOOKUP(ZN(SUM([profit])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='Total Orders Placed By Customer' datatype='integer' name='[Calculation_0077791953297415]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='// Returns all the orders placed by a customer&#13;&#10;{ FIXED [customer_name]:[Calculation_1213312394600478]}' />
      </column>
      <column caption='Sales or profit' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;(&quot;$&quot;#,##0,.00K)' name='[Calculation_0077792040755212]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 3]&#13;&#10;when 1 then [sales]&#13;&#10;when 2 then [profit]&#13;&#10;END' />
      </column>
      <column caption='Sales for Category (Chart)' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;(&quot;$&quot;#,##0,.00K)' name='[Calculation_0968948729937920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [category] : SUM([sales])}' />
      </column>
      <column caption='Profit CY (Chart)' datatype='real' name='[Calculation_1131399323553793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&quot;year&quot;,[order_date]) = [Parameters].[Parameter 5]&#13;&#10;THEN [profit]&#13;&#10;END' />
      </column>
      <column caption='Profit PY (Chart)' datatype='real' name='[Calculation_1131399323840514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF DATEPART(&quot;year&quot;,[order_date]) = ([Parameters].[Parameter 5])-1&#13;&#10;THEN [profit]&#13;&#10;END' />
      </column>
      <column caption='Current Year Profit' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;(&quot;$&quot;#,##0,.00K)' name='[Calculation_1131399324979203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#13;&#10;WHEN &quot;Profit&quot; THEN SUM([Calculation_1131399323553793])&#13;&#10;END' />
      </column>
      <column caption='Previous Year Profit' datatype='real' name='[Calculation_1131399325995014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 6]&#13;&#10;&#13;&#10;WHEN &quot;Profit&quot; THEN SUM([Calculation_1131399323840514])&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_1155378283642880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Returned Quantity' datatype='integer' name='[Calculation_1213312264929285]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Returned] = &quot;Yes&quot; THEN [quantity] ELSE 0 END' />
      </column>
      <column caption='Returned Sales Value' datatype='real' default-format='c&quot;$&quot;#,##0,,.00M;(&quot;$&quot;#,##0,,.00M)' name='[Calculation_1213312270016518]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Returned] = &quot;Yes&quot; THEN [sales] ELSE 0 END' />
      </column>
      <column caption='Returned Orders' datatype='integer' name='[Calculation_1213312277573639]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Returned] = &quot;Yes&quot; THEN [Order ID] END)' />
      </column>
      <column caption='Return Count per Order' datatype='integer' name='[Calculation_1213312298536983]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Order ID] : SUM(IF [Returned] = &quot;Yes&quot; THEN 1 ELSE 0 END)}' />
      </column>
      <column caption='p. All or Returned' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_1213312394600478]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='case [Parameters].[Parameter 4]&#13;&#10;when 1 then COUNTD([order_id])&#13;&#10;when 2 then [Calculation_1213312277573639]&#13;&#10;END' />
      </column>
      <column caption='sales CY ( KPI)' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;(&quot;$&quot;#,##0,.00K)' name='[Calculation_1553402887835648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([order_date])= {MAX(YEAR([order_date]))}&#13;&#10;THEN [sales]&#13;&#10;END  ) }' />
